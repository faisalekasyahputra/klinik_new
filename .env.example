# ==============================================================
# Klinik PKP - Environment Configuration TEMPLATE
# ==============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.
# Jalankan perintah berikut untuk generate kunci baru:
#   php -r "echo bin2hex(random_bytes(32));"   → untuk DATA_KEY
#   php -r "echo bin2hex(random_bytes(16));"   → untuk DATA_PEPPER
# ==============================================================

# --- Kunci Enkripsi Data PII (UU PDP) ---
KPKP_DATA_KEY=your_64_char_hex_key_here
KPKP_DATA_PEPPER=your_32_char_hex_pepper_here

# --- Google OAuth 2.0 Credentials ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/klinik/Auth/google_callback

# --- Google reCAPTCHA v2 ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Google Gemini AI API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- SIMPERUM (aktifkan mode api hanya setelah UAT) ---
SIMPERUM_MODE=simulation
SIMPERUM_BASE_URL=https://simperum.disperakim.jatengprov.go.id/api/pub/
SIMPERUM_PUBLIC_KEY=
SIMPERUM_PRIVATE_KEY=
SIMPERUM_CONNECT_TIMEOUT=5
SIMPERUM_TIMEOUT=12

# --- Lokasi penyimpanan berkas privat (KTP, KTM, lampiran aduan, dokumen SRP2) ---
# WAJIB menunjuk direktori DI LUAR DocumentRoot web server.
# Boleh absolut (/home/user/simpanan_privat) atau relatif terhadap folder aplikasi
# (../private_uploads). Kalau dikosongkan, jatuh ke ../private_uploads relatif
# aplikasi - TAPI itu belum tentu di luar DocumentRoot (di XAMPP lokal justru
# tidak), jadi sebaiknya diisi eksplisit per lingkungan.
PRIVATE_UPLOADS_PATH=
# --- Web Push admin (buat pasangan kunci berbeda per lingkungan) ---
# Generate: php -r "require 'vendor/autoload.php'; var_export(Minishlink\WebPush\VAPID::createVapidKeys());"
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
