# ============================================
# .gitignore — Klinik PKP (klinik_new)
# ============================================

# ── Environment & Secrets ──────────────────
.env
.env.*
!.env.example

# ── Dependencies ───────────────────────────
/vendor/
/node_modules/
composer.lock
package-lock.json

# ── CI3 Cache & Logs ──────────────────────
application/cache/*
!application/cache/index.html
application/logs/*
!application/logs/index.html
!application/*/.htaccess

# ── Uploads & User-Generated Content ──────
/uploads/
/assets/cache_foto/

# ── Unused / Archived Assets ──────────────
/assets/img/_unused/

# ── Migration Scripts (one-time use) ──────
migrate_*.php
test_api.php
clean_bg.py

# ── Dev/debug scripts (never deploy — DB access, no auth) ──
/dev-scripts/

# ── Large local-only artifacts (recordings, reference images — not web assets) ──
/local-assets/

# ── Build Output ──────────────────────────
/assets/css/output.css.map

# ── OS Files ──────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE & Editor ──────────────────────────
.idea/
.vscode/
# `.claude/*`, BUKAN `.claude/` — git tidak bisa membuka kembali berkas yang
# direktori induknya dikecualikan, jadi pengecualian di bawah cuma berlaku
# kalau yang diabaikan isinya, bukan direktorinya.
.claude/*
# Agen per-peran DILACAK supaya bisa dipakai ulang siapa pun yang meng-clone
# (permintaan user 5 Agt 2026). Isinya instruksi, bukan setelan mesin.
# `settings.local.json` tetap terabaikan — itu preferensi per-mesin.
!.claude/agents/
.codex/
/nbproject/
*.sublime-workspace
*.sublime-project
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache

# ── Local design references & generated artifacts ──
/new_flow/
/outputs/
/output/
/tmp/

# ── Playwright / Testing ──────────────────
.playwright-mcp/
/tests/tests/
/tests/results/
tests/mocks/database/ci_test.sqlite

# ── CI3 User Guide (not needed) ──────────
user_guide_src/build/*
user_guide_src/cilexer/build/*
user_guide_src/cilexer/dist/*
user_guide_src/cilexer/pycilexer.egg-info/*

# Foto program yang diunggah admin lewat Katalog Program (migrasi 036).
# Berkas BAWAAN di assets/img/program/ tetap dilacak — ia nilai awal migrasi.
# Yang di bawah ini data, bukan kode: ia lahir di server tempat diunggah, dan
# `git pull` saat auto-deploy tidak menyentuh berkas tak terlacak.
assets/img/program/unggahan/
