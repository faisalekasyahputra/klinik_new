<IfModule mod_rewrite.c>
    RewriteEngine on

    # ============================================================
    # PROTEKSI BERKAS SENSITIF - JANGAN DIHAPUS
    # ============================================================
    # Aturan front-controller di bawah HANYA menangani URL yang tidak cocok
    # dengan berkas nyata (RewriteCond !-f), jadi tanpa blok ini setiap berkas
    # yang benar-benar ada di DocumentRoot tersaji apa adanya. Diverifikasi
    # 26 Jul 2026 sebelum blok ini ditambahkan: GET /.env membalas HTTP 200 di
    # staging DAN production - password DB tiga lingkungan, KPKP_DATA_KEY,
    # KPKP_DATA_PEPPER, GOOGLE_CLIENT_SECRET, dan GEMINI_API_KEY bisa diunduh
    # siapa saja. Lihat docs/engineering/PEMBACAAN_CODEBASE_26JUL2026.md.
    #
    # `.well-known` SENGAJA dikecualikan lewat negative lookahead: direktori itu
    # dipakai proses perpanjangan sertifikat SSL (ACME). Memblokirnya membuat
    # sertifikat gagal diperpanjang dan situs mati total saat kedaluwarsa.
    RewriteRule (^|/)\.(?!well-known/)[^/]* - [F,L]

    # Poin 12.4 (docs/engineering/URI_DAN_METODE_HTTP.md): metode selain GET/HEAD/POST/OPTIONS ditolak
    # di lapisan server, untuk SEMUA jalur termasuk berkas statis. Terutama TRACE/TRACK: ditangani
    # server SEBELUM PHP dan memantulkan seluruh header permintaan (termasuk Cookie) ke pemanggil.
    # Aplikasi sendiri sudah menjawab 405 untuk PUT/DELETE/PATCH di jalur PHP (Http_policy).
    # CATATAN: pada Apache mandiri TRACE tetap dilayani inti server walau ada aturan ini; tutup dengan
    # `TraceEnable off` di konfigurasi server (tidak bisa lewat .htaccess). Di hosting produksi TRACE
    # sudah ditolak 405 oleh lapisan tepi (diverifikasi 21 Sep 2026).
    RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST|OPTIONS)$ [NC]
    RewriteRule ^ - [R=405,L]

    # Dokumentasi internal & script dev ikut ter-deploy tapi bukan untuk publik:
    # memuat skema DB lengkap, dokumen audit keamanan, dan arsitektur internal.
    # `tests` dan `vendor` ditambahkan 20 Sep 2026: skrip di dalamnya bisa
    # DIJALANKAN lewat HTTP (bukan sekadar dibaca) karena berekstensi .php di
    # bawah webroot, dan vendor/composer/installed.json membuka daftar versi
    # pustaka. Aplikasi tidak pernah memuat berkas dari vendor/ lewat URL.
    # Yang diblokir direktorinya, bukan daftar berkasnya, supaya isi baru
    # otomatis ikut terlindungi.
    RewriteRule ^(docs|dev-scripts|tests|vendor)/ - [F,L]
    RewriteRule ^[^/]+\.md$ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]

    # Log PHP. Berkas ini LAHIR SENDIRI saat runtime, tanpa commit - jadi ia
    # tidak pernah muncul di tinjauan repo, tidak ada di daftar mana pun, dan
    # tiga aturan di atas semuanya meleset: ia bukan dotfile, bukan .md, bukan
    # di docs/. Diverifikasi 4 Agt 2026: GET /error_log membalas HTTP 200 dengan
    # 15 KB isi, satu-satunya berkas akar yang bocor dari delapan yang diuji.
    #
    # Isinya saat ditemukan kebetulan tidak berbahaya (30 peringatan startup
    # modul Hostinger). Yang ditutup di sini bukan isi itu, melainkan KELASNYA:
    # galat PHP rutin memuat path absolut server, potongan SQL, dan kadang nilai
    # variabel - dan di aplikasi ini variabel itu bisa berisi NIK atau email.
    RewriteRule (^|/)(error_log|php_errorlog|[^/]+\.log)$ - [F,L]

    # Dump/backup basis data. Ditemukan 26 Agt 2026: TIGA backup production
    # UTUH menyaji HTTP 200 di akar - backup_sebelum_migrasi0{44,48,50}_*.sql,
    # 125-131 KB, 44 tabel, berisi usr_users (termasuk hash kata sandi),
    # sf_profil_warga, srp2_registrations, srp2_documents, sys_jejak_audit.
    # Berkasnya lahir dari kebiasaan "backup dulu sebelum migrasi" yang
    # menaruh dump di direktori kerja - dan direktori kerja itu DocumentRoot.
    #
    # Persis pola error_log di atas: bukan dotfile, bukan .md, bukan di docs/,
    # jadi keempat aturan sebelumnya meleset semua. Temuan 24 Agt soal
    # dummy_simperum.sql sudah menunjukkan .sql tidak tertutup, tapi ditutup
    # sebagai "cuma data sintetis" - kelasnya tidak ikut ditambal, dan tiga
    # dump sungguhan menyusul ke lubang yang sama.
    #
    # Backup-nya sudah dipindah ke ~/backup_klinik (di luar DocumentRoot).
    # Aturan ini yang menahan pengulangannya, dan .gz ikut disebut karena
    # runbook rilis memakai mysqldump | gzip.
    RewriteRule (^|/)[^/]+\.(sql|dump|bak)(\.gz)?$ - [F,L]

    # Poin 13.3: DocumentRoot menyajikan HANYA yang memang untuk publik. Berkas atau direktori yang benar-benar
    # ada di luar daftar ini (license.txt, README, composer.*, cadangan, salinan konfigurasi, berkas sampel,
    # direktori dev) dijawab 403, apa pun namanya dan kapan pun ia muncul. Daftar tolak per pola di atas
    # menutup yang sudah dikenal; daftar IZIN ini menutup yang belum terpikirkan. Alamat virtual aplikasi
    # (/login, /Program/..., dst.) bukan berkas nyata, jadi tidak terkena dan tetap diteruskan ke index.php.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(?!$|index\.php(/|$)|push-sw\.js$|manifest\.webmanifest$|assets/|\.well-known/).+ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

# Poin 13.5: jenis konten yang benar dan berkarakter set untuk aset statis (bawaan server dapat memberi
# application/x-javascript tanpa charset). Bersama nosniff, peramban tidak menebak jenis kontennya.
<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
    AddType text/css .css
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
    AddCharset UTF-8 .js .mjs .css .webmanifest
</IfModule>

# ============================================================
# BROWSER CACHING - Aset statis di-cache di browser
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # CSS & JavaScript - cache 1 bulan
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Gambar - cache 1 tahun
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Font - cache 1 tahun
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
    # Poin 12.2: buang penanda teknologi dari respons berkas statis juga (PHP sudah membuangnya sendiri).
    Header always unset X-Powered-By

    # Poin 13.5: header keamanan inti pada berkas STATIS (tidak melewati PHP). Respons PHP, termasuk 404/galat
    # buatan CodeIgniter (MY_Exceptions), memasangnya sendiri lewat kirim_header_keamanan(); menerapkannya dua
    # kali di sini akan MENGGANDAKAN header (mis. "X-Frame-Options: DENY, DENY" dapat diabaikan peramban).
    <FilesMatch "\.(css|js|mjs|map|json|webmanifest|txt|xml|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot|pdf)$">
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-Frame-Options "DENY"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ============================================================
# GZIP COMPRESSION - Kompres response text untuk transfer lebih cepat
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ETag for cache validation
FileETag MTime Size
